---
import BaseLayout   from '../../layouts/BaseLayout.astro';
import Header       from '../../components/Header.astro';
import ServiceHero  from '../../components/ServiceHero.astro';
import Kontakt      from '../../components/Kontakt.astro';
import Footer       from '../../components/Footer.astro';

const icon = `<svg viewBox="0 0 32 52" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
  <rect x="13" y="0" width="6" height="38" rx="2"/>
  <rect x="13" y="1" width="16" height="5" rx="1.5"/>
  <path d="M19 3 L29 14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
  <rect x="9" y="38" width="14" height="7" rx="2"/>
  <circle cx="8" cy="47" r="5"/>
  <circle cx="24" cy="47" r="5"/>
  <circle cx="16" cy="17" r="2.5"/>
</svg>`;

const sluzby = [
  { name: 'Montáž ocelových konstrukcí a hal',      desc: 'Přesné osazení nosníků, sloupů, vazníků a celých ocelových halových konstrukcí.' },
  { name: 'Zdvíhání a přemísťování strojů',         desc: 'Bezpečné zdvíhání těžkých strojů při instalaci, přesunu nebo servisní práci.' },
  { name: 'Osazování prefabrikátů',                 desc: 'Betonové panely, schodišťová ramena, překlady, střešní desky a průmyslové prvky.' },
  { name: 'Nakládka nadrozměrného zboží',           desc: 'Nakládka a vykládka strojů, transformátorů, výrobních linek a technologií.' },
  { name: 'Instalace technologických zařízení',     desc: 'Osazování vzduchotechniky, výtahových šachet, průmyslových komínů a věží.' },
  { name: 'Výškové a stísněné prostory',            desc: 'Mobilní jeřáby umožňují práci i tam, kde není přístup pro větší mechanizaci.' },
];

const postup = [
  { n: '01', title: 'Konzultace',       text: 'Probereme technické parametry: nosnost, dosah, výška zdvihu, dostupnost terénu a bezpečnostní zóna.' },
  { n: '02', title: 'Příprava',         text: 'Zajistíme potřebná povolení, statický posudek zdvihu a příjezdovou trasu pro jeřáb.' },
  { n: '03', title: 'Realizace zdvihu', text: 'Jeřábník s certifikací provede zdvih bezpečně, přesně a v souladu s plánem.' },
  { n: '04', title: 'Protokol',         text: 'Po dokončení vystavíme protokol o provedení zdvíhací operace pro potřeby stavebního deníku.' },
];

const technika = [
  { name: 'Mobilní jeřáb 60 t',    specs: ['Nosnost: 60 t', 'Dosah ramene: až 40 m', 'Výška zdvihu: až 50 m'] },
  { name: 'Mobilní jeřáb 25 t',    specs: ['Nosnost: 25 t', 'Dosah ramene: až 28 m', 'Flexibilní nasazení ve stísněných prostorách'] },
  { name: 'Věžový jeřáb (pronájem)', specs: ['Nosnost: 8 t', 'Dosah: až 55 m', 'Pro výstavbu bytových a průmyslových objektů'] },
];
---

<BaseLayout
  title="Jeřábnické práce | Profi Jeřáby s.r.o."
  description="Profesionální jeřábnické práce — montáž ocelových konstrukcí, zdvíhání strojů, osazování prefabrikátů. Mobilní jeřáby s nosností až 60 t."
>
  <Header />
  <main>
    <ServiceHero
      title="JEŘÁBNICKÉ"
      accent="PRÁCE"
      tagline="Přesné zdvíhání a přemísťování těžkých břemen"
      desc="Provádíme montáže ocelových konstrukcí, zdvíhání a přemísťování strojů a technologií. Disponujeme mobilními jeřáby s nosností až 60 tun a certifikovanými jeřábníky pro bezpečnou realizaci i náročných zakázek."
      icon={icon}
    />

    <!-- Co nabízíme -->
    <section class="sekce bg-alt">
      <div class="container">
        <p class="section-label">Co provádíme</p>
        <h2 class="section-title">ROZSAH <span>PRACÍ</span></h2>
        <div class="dvoj">
          <p class="dvoj-text">
            Jeřábnické práce jsou oblastí, kde přesnost a bezpečnost nemají alternativu.
            Naši certifikovaní jeřábníci mají za sebou stovky úspěšně realizovaných zdvihů
            — od jednoduchých montáží po komplexní instalace průmyslových technologií.
            Každý zdvih pečlivě naplánujeme, provedeme a zdokumentujeme.
          </p>
          <ul class="sluzby-list">
            {sluzby.map(s => (
              <li>
                <div class="sl-dot" aria-hidden="true"></div>
                <div>
                  <strong>{s.name}</strong>
                  <span>{s.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Jak pracujeme -->
    <section class="sekce">
      <div class="container">
        <p class="section-label">Průběh zakázky</p>
        <h2 class="section-title">JAK <span>PRACUJEME</span></h2>
        <div class="postup-grid">
          {postup.map(p => (
            <div class="krok">
              <span class="krok-n" aria-hidden="true">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Technika -->
    <section class="sekce bg-alt">
      <div class="container">
        <p class="section-label">Vozový park</p>
        <h2 class="section-title">NAŠE <span>TECHNIKA</span></h2>
        <div class="vozidla-grid">
          {technika.map(v => (
            <div class="vozidlo">
              <div class="vozidlo-foto">
                <div class="foto-placeholder" aria-hidden="true">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              </div>
              <div class="vozidlo-info">
                <h3>{v.name}</h3>
                <ul>
                  {v.specs.map(s => <li>{s}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Kontakt />
  </main>
  <Footer />
</BaseLayout>

<style>
  .sekce { padding: clamp(60px, 8vw, 100px) 0; }
  .bg-alt { background: var(--bg-2); }

  .dvoj {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    margin-top: 40px;
    align-items: start;
  }
  .dvoj-text { font-size: 0.96rem; color: var(--text-muted); line-height: 1.8; }

  .sluzby-list { display: flex; flex-direction: column; gap: 18px; }
  .sluzby-list li { display: flex; gap: 14px; align-items: flex-start; }
  .sl-dot {
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }
  .sluzby-list strong { display: block; font-size: 0.9rem; color: var(--white); margin-bottom: 2px; }
  .sluzby-list span { font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; }

  .postup-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    margin-top: 40px;
  }
  .krok {
    background: var(--bg-3);
    padding: 32px 28px;
    border-top: 3px solid transparent;
    transition: border-color var(--transition), background var(--transition);
  }
  .krok:hover { border-top-color: var(--accent); background: #1f1f1f; }
  .krok-n { display: block; font-family: var(--ff-heading); font-size: 3.5rem; color: var(--border-2); line-height: 1; margin-bottom: 12px; }
  .krok h3 { font-size: 1.4rem; color: var(--white); text-transform: uppercase; margin-bottom: 10px; }
  .krok p { font-size: 0.84rem; color: var(--text-muted); line-height: 1.7; }

  .vozidla-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 40px; }
  .vozidlo { background: var(--bg-3); overflow: hidden; }
  .vozidlo-foto { aspect-ratio: 4/3; background: #111; }
  .foto-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--border-2); }
  .vozidlo-info { padding: 18px 20px; border-left: 3px solid var(--accent); }
  .vozidlo-info h3 { font-size: 1.15rem; color: var(--white); text-transform: uppercase; margin-bottom: 8px; }
  .vozidlo-info ul { display: flex; flex-direction: column; gap: 3px; }
  .vozidlo-info li { font-size: 0.78rem; color: var(--text-muted); padding-left: 12px; position: relative; }
  .vozidlo-info li::before { content: '›'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }

  @media (max-width: 900px) {
    .dvoj { grid-template-columns: 1fr; gap: 32px; }
    .postup-grid { grid-template-columns: repeat(2, 1fr); }
    .vozidla-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .postup-grid { grid-template-columns: 1fr; }
    .vozidla-grid { grid-template-columns: 1fr; }
  }
</style>
