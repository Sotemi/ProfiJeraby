---
// Galerie realizací
// Nahraďte placeholder div elementy za <img> tagy s vlastními fotkami:
// <img src="/assets/images/galerie/foto-01.jpg" alt="Popis realizace" loading="lazy" />
const items = Array.from({ length: 9 }, (_, i) => i + 1);
---

<section id="galerie" class="galerie">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Naše realizace</p>
      <h2 class="section-title">GALERIE <span>PRACÍ</span></h2>
    </div>

    <div class="grid">
      {items.map((n, i) => (
        <div class={`item${i === 0 ? ' item--wide' : ''}${i === 5 ? ' item--tall' : ''}`}>
          <!--
            Vlastní fotka:
            <img src="/assets/images/galerie/foto-{n}.jpg" alt="Realizace {n}" loading="lazy" />
          -->
          <div class="placeholder" aria-label={`Foto realizace ${n}`}>
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span>Foto {n}</span>
          </div>
        </div>
      ))}
    </div>

    <p class="note">Fotografie realizací budou průběžně doplňovány. Přidejte vlastní fotky do <code>/public/assets/images/galerie/</code>.</p>
  </div>
</section>

<style>
  .galerie {
    padding: clamp(60px,8vw,100px) 0;
    background: var(--bg-2);
    position: relative;
  }
  .galerie::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-2), transparent);
  }

  .section-header { margin-bottom: 44px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 3px;
  }

  .item {
    overflow: hidden;
    cursor: pointer;
    position: relative;
    background: var(--bg-3);
  }
  .item--wide  { grid-column: span 2; }
  .item--tall  { grid-row: span 2; }

  .item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease, filter 0.4s ease;
    display: block;
  }
  .item:hover img {
    transform: scale(1.06);
    filter: brightness(0.75);
  }

  .placeholder {
    width: 100%; height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--border-2);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background var(--transition), color var(--transition);
  }
  .item:hover .placeholder {
    background: #1f1f1f;
    color: var(--text-muted);
  }

  .note {
    margin-top: 28px;
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
    font-style: italic;
  }
  .note code {
    font-size: 0.78rem;
    color: var(--accent);
    background: rgba(245,166,35,0.1);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .item--wide, .item--tall { grid-column: span 1; grid-row: span 1; }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; grid-auto-rows: 200px; }
  }
</style>
