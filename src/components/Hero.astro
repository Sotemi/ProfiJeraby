---
---

<section id="uvod" class="hero">
  <div class="hero-inner">
    <!-- Left: text -->
    <div class="hero-text">
      <p class="hero-eyebrow">Profesionální technika pro každou zakázku</p>

      <h1 class="hero-title">
        PROFI<br />
        <span>JEŘÁBY</span>
      </h1>
      <p class="hero-sro">s.r.o.</p>

      <div class="hero-services">
        <span>Autodoprava</span>
        <i aria-hidden="true">·</i>
        <span>Jeřábnické práce</span>
        <i aria-hidden="true">·</i>
        <span>Zemní práce</span>
      </div>

      <p class="hero-slogan">Síla strojů. Zkušenosti lidí.</p>

      <div class="hero-actions">
        <a href="tel:+420000000000" class="btn btn-primary btn-lg">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          Zavolat nyní
        </a>
        <a href="#sluzby" class="btn btn-outline btn-lg">
          Naše služby
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Rychlý stat bar -->
      <div class="hero-stats">
        <div class="stat">
          <strong>10+</strong>
          <span>let zkušeností</span>
        </div>
        <div class="stat-sep" aria-hidden="true"></div>
        <div class="stat">
          <strong>500+</strong>
          <span>realizovaných zakázek</span>
        </div>
        <div class="stat-sep" aria-hidden="true"></div>
        <div class="stat">
          <strong>24/7</strong>
          <span>pohotovostní servis</span>
        </div>
      </div>
    </div>

    <!-- Right: brand image -->
    <div class="hero-image" aria-hidden="true">
      <img
        src="/assets/images/logo-hero.jpg"
        alt="Profi Jeřáby – technika"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-image-glow"></div>
    </div>
  </div>

  <!-- Scroll cue -->
  <a href="#sluzby" class="scroll-cue" aria-label="Přejít dolů">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M7 10l5 5 5-5"/>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--bg);
    overflow: hidden;
    padding-top: 68px; /* header height */
  }

  /* Subtle background texture */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 70% 50%, rgba(245,166,35,0.055) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 10% 80%, rgba(245,166,35,0.03) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px clamp(20px,4vw,48px);
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  /* ---- Text side ---- */
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(4.5rem, 10vw, 9.5rem);
    color: var(--white);
    line-height: 0.88;
    margin-bottom: 6px;
    text-shadow: 0 4px 40px rgba(0,0,0,0.4);
  }
  .hero-title span { color: var(--accent); }

  .hero-sro {
    font-family: var(--ff-heading);
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    color: var(--text-muted);
    letter-spacing: 0.12em;
    margin-bottom: 28px;
  }

  .hero-services {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
  }
  .hero-services i {
    color: var(--accent);
    font-style: normal;
  }

  .hero-slogan {
    font-family: var(--ff-heading);
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  /* Stats bar */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat strong {
    font-family: var(--ff-heading);
    font-size: 1.8rem;
    color: var(--accent);
    line-height: 1;
  }
  .stat span { font-size: 0.75rem; color: var(--text-muted); }
  .stat-sep {
    width: 1px; height: 36px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ---- Image side ---- */
  .hero-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-image img {
    width: 100%;
    max-width: 560px;
    border-radius: 6px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.7);
    position: relative;
    z-index: 1;
  }
  .hero-image-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(ellipse at center, rgba(245,166,35,0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-dim);
    animation: bob 2s ease-in-out infinite;
    transition: color var(--transition);
  }
  .scroll-cue:hover { color: var(--accent); }
  @keyframes bob {
    0%,100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(7px); }
  }

  /* Responsive */
  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-text { order: 2; }
    .hero-image { order: 1; }
    .hero-eyebrow,
    .hero-services,
    .hero-slogan { justify-content: center; }
    .hero-actions { justify-content: center; }
    .hero-stats { justify-content: center; }
    .hero-image img { max-width: 360px; }
  }
  @media (max-width: 480px) {
    .hero-stats { gap: 16px; }
  }
</style>
