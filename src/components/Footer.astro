---
const year = new Date().getFullYear();

const navLinks = [
  { href: '#uvod',      label: 'Úvod' },
  { href: '#sluzby',    label: 'Služby' },
  { href: '#technika',  label: 'Technika' },
  { href: '#galerie',   label: 'Galerie' },
  { href: '#reference', label: 'Reference' },
  { href: '#kontakt',   label: 'Kontakt' },
];
---

<footer class="footer">
  <div class="footer-body">
    <div class="container">
      <div class="grid">

        <!-- Brand -->
        <div class="col-brand">
          <a href={import.meta.env.BASE_URL} class="logo" aria-label="Profi Jeřáby – domů">
            <div class="hex">PJ</div>
            <div>
              <span class="lmain">PROFI JEŘÁBY</span>
              <span class="lsub">s.r.o.</span>
            </div>
          </a>
          <p class="tagline">
            Síla strojů. Zkušenosti lidí.<br />
            Výsledky, které stojí za to.
          </p>
          <a href="tel:+420000000000" class="footer-tel">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
            </svg>
            +420 000 000 000
          </a>
        </div>

        <!-- Nav -->
        <div class="col">
          <h4>Navigace</h4>
          <ul>
            {navLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>

        <!-- Services -->
        <div class="col">
          <h4>Služby</h4>
          <ul>
            <li><a href="#sluzby">Autodoprava</a></li>
            <li><a href="#sluzby">Jeřábnické práce</a></li>
            <li><a href="#sluzby">Zemní práce</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div class="col">
          <h4>Kontakt</h4>
          <ul class="contact-list">
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
              </svg>
              <a href="tel:+420000000000">+420 000 000 000</a>
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <a href="mailto:info@profijeraby.cz">info@profijeraby.cz</a>
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/>
              </svg>
              <span>Doplňte adresu, CZ</span>
            </li>
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm.01 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
              </svg>
              <span>www.profijeraby.cz</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {year} Profi Jeřáby s.r.o. Všechna práva vyhrazena.</p>
      <p>Autodoprava · Jeřábnické práce · Zemní práce</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #080808;
    border-top: 3px solid var(--accent);
  }

  .footer-body { padding: 56px 0 36px; }

  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 36px;
  }

  /* Brand col */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .hex {
    width: 40px; height: 40px;
    background: var(--accent);
    color: #000;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--ff-heading);
    font-size: 1.1rem;
    clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
    flex-shrink: 0;
  }
  .lmain { display: block; font-family: var(--ff-heading); font-size: 1.2rem; color: var(--white); }
  .lsub  { display: block; font-size: 0.6rem; color: var(--text-muted); letter-spacing: 0.1em; }

  .tagline {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 18px;
  }
  .footer-tel {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--ff-heading);
    font-size: 1.25rem;
    color: var(--accent);
  }
  .footer-tel:hover { color: var(--accent-hover); }

  /* Generic cols */
  .col h4 {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 14px;
  }
  .col ul li { margin-bottom: 8px; }
  .col a {
    font-size: 0.83rem;
    color: var(--text-muted);
    transition: color var(--transition);
  }
  .col a:hover { color: var(--accent); }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 0.83rem;
    color: var(--text-muted);
    margin-bottom: 10px;
  }
  .contact-list svg { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .contact-list a:hover { color: var(--accent); }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 18px 0;
  }
  .footer-bottom .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .footer-bottom p { font-size: 0.77rem; color: var(--text-dim); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .footer-bottom .container { flex-direction: column; text-align: center; }
  }
</style>
