---
const navLinks = [
  { href: '#uvod',      label: 'Úvod' },
  { href: '#sluzby',    label: 'Služby' },
  { href: '#technika',  label: 'Technika' },
  { href: '#galerie',   label: 'Galerie' },
  { href: '#reference', label: 'Reference' },
  { href: '#kontakt',   label: 'Kontakt' },
];
---

<header id="site-header">
  <div class="container">
    <a href={import.meta.env.BASE_URL} class="logo" aria-label="Profi Jeřáby – domů">
      <div class="logo-hex">PJ</div>
      <div class="logo-text">
        <span class="logo-main">PROFI JEŘÁBY</span>
        <span class="logo-sub">s.r.o.</span>
      </div>
    </a>

    <nav id="main-nav" aria-label="Hlavní navigace">
      <ul>
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="tel:+420000000000" class="btn btn-primary header-cta">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      Zavolat
    </a>

    <button
      class="hamburger"
      id="hamburger-btn"
      aria-label="Otevřít menu"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(13,13,13,0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: box-shadow var(--transition), background var(--transition);
  }
  header.scrolled {
    background: rgba(10,10,10,0.98);
    box-shadow: 0 2px 24px rgba(0,0,0,0.6);
  }

  .container {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 68px;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
  }
  .logo-hex {
    width: 38px;
    height: 38px;
    background: var(--accent);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ff-heading);
    font-size: 1.15rem;
    font-weight: 400;
    clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
    flex-shrink: 0;
  }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-main {
    font-family: var(--ff-heading);
    font-size: 1.25rem;
    color: var(--white);
    letter-spacing: 0.04em;
  }
  .logo-sub {
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Nav */
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 2px; }
  nav a {
    display: block;
    padding: 8px 11px;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    transition: color var(--transition);
    position: relative;
  }
  nav a::after {
    content: '';
    position: absolute;
    bottom: 3px; left: 11px; right: 11px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform var(--transition);
  }
  nav a:hover          { color: var(--white); }
  nav a:hover::after   { transform: scaleX(1); }

  /* CTA */
  .header-cta { padding: 9px 18px; font-size: 0.82rem; flex-shrink: 0; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 22px; height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile nav */
  @media (max-width: 880px) {
    nav {
      position: fixed;
      top: 68px; left: 0; right: 0;
      background: rgba(13,13,13,0.98);
      border-bottom: 1px solid var(--border);
      padding: 16px 20px 24px;
      /* Skrytí: opacity+visibility je spolehlivé — transform -110% nepokryje celý nav */
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-6px);
      transition:
        opacity 0.22s ease,
        transform 0.22s ease,
        visibility 0s linear 0.22s;
    }
    nav.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition:
        opacity 0.22s ease,
        transform 0.22s ease,
        visibility 0s;
    }
    nav ul { flex-direction: column; gap: 2px; }
    nav a { padding: 11px 8px; font-size: 1rem; color: var(--text); }
    .header-cta { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script>
  const btn    = document.getElementById('hamburger-btn');
  const nav    = document.getElementById('main-nav');
  const header = document.getElementById('site-header');

  btn?.addEventListener('click', () => {
    const open = btn.classList.toggle('open');
    nav?.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
  });

  document.querySelectorAll('#main-nav a').forEach(a => {
    a.addEventListener('click', () => {
      btn?.classList.remove('open');
      nav?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
</script>
