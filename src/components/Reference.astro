---
const refs = [
  {
    quote: 'Skvělá spolupráce, vše proběhlo přesně podle plánu. Jeřábnické práce provedeny profesionálně, bezpečně a v termínu.',
    name: 'Stavební firma ABC',
    project: 'Montáž ocelové haly',
  },
  {
    quote: 'Spolehlivá autodoprava, vždy dochvilní. Doporučujeme pro přepravu sypkých materiálů ve větším objemu.',
    name: 'XYZ Stavby s.r.o.',
    project: 'Výstavba rodinných domů',
  },
  {
    quote: 'Zemní práce zvládli i v náročných podmínkách. Rychle, čistě, bez zbytečných komplikací. Budeme opakovat.',
    name: 'Obec Horní Město',
    project: 'Rekonstrukce inženýrských sítí',
  },
];
---

<section id="reference" class="reference">
  <div class="container">
    <div class="section-header">
      <p class="section-label">Spokojení zákazníci</p>
      <h2 class="section-title">NAŠE <span>REFERENCE</span></h2>
    </div>

    <div class="grid">
      {refs.map(r => (
        <article class="card">
          <span class="qmark" aria-hidden="true">"</span>
          <blockquote>{r.quote}</blockquote>
          <div class="stars" aria-label="Hodnocení 5 z 5">
            {Array.from({length:5}).map(() => (
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            ))}
          </div>
          <div class="author">
            <div class="avatar" aria-hidden="true">{r.name.charAt(0)}</div>
            <div>
              <p class="author-name">{r.name}</p>
              <p class="author-project">{r.project}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA banner -->
    <div class="banner">
      <div class="banner-text">
        <h3>Chcete se stát naším spokojeným zákazníkem?</h3>
        <p>Nezávazná poptávka zdarma. Odpovíme do 24 hodin.</p>
      </div>
      <a href="#kontakt" class="btn btn-primary">Kontaktovat nás</a>
    </div>
  </div>
</section>

<style>
  .reference {
    padding: clamp(60px,8vw,100px) 0;
    background: var(--bg);
  }
  .section-header { margin-bottom: 48px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 48px;
  }

  .card {
    background: var(--bg-3);
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: background var(--transition);
  }
  .card:hover { background: #1f1f1f; }

  .qmark {
    display: block;
    font-family: Georgia, serif;
    font-size: 5.5rem;
    color: var(--accent);
    opacity: 0.14;
    line-height: 0.7;
    margin-bottom: 14px;
    user-select: none;
  }

  blockquote {
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.75;
    font-style: italic;
    margin-bottom: 18px;
  }

  .stars {
    display: flex;
    gap: 3px;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 38px; height: 38px;
    background: var(--accent);
    color: #000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }
  .author-name {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--white);
  }
  .author-project {
    font-size: 0.73rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* CTA banner */
  .banner {
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    padding: 30px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .banner-text h3 {
    font-size: 1.55rem;
    color: var(--white);
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .banner-text p { font-size: 0.88rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .banner { flex-direction: column; text-align: center; padding: 28px 24px; }
  }
</style>
